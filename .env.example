# ─────────────────────────────────────────────────────────────────────────────
# Drop — environment template
# Copy the relevant lines into your real .env (or production secret manager).
# In this sandbox .env is auto-managed (only DATABASE_URL is preserved), so use
# .env.local on your own machine or your CI/CD secret store for the tokens.
# ─────────────────────────────────────────────────────────────────────────────

DATABASE_URL=file:./db/custom.db

# Which provider to preselect in the UI. Leave unset to auto-pick the first
# configured one (github > gitlab > local).
# DROP_DEFAULT_PROVIDER=github

# ── GitHub Pages ─────────────────────────────────────────────────────────────
# 1. Create a public (or GH-Pages-enabled) repo, e.g. your-org/experiments
# 2. Settings → Pages → Source = Deploy from branch → pick branch + /root
# 3. Create a fine-grained PAT: Repository access = the repo,
#    Permissions → Contents = Read and Write
# GITHUB_TOKEN=github_pat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# GITHUB_OWNER=your-org
# GITHUB_REPO=experiments
# GITHUB_BRANCH=main            # the branch Pages serves from (e.g. "gh-pages")
# GITHUB_PATH_PREFIX=           # optional subfolder inside the repo
# GITHUB_PAGES_BASE=            # optional override, e.g. custom domain

# ── GitLab Pages ─────────────────────────────────────────────────────────────
# 1. Create a project, enable Pages (Settings → Pages)
# 2. User Settings → Access Tokens → token with `api` scope on the project
# GITLAB_TOKEN=glpat-xxxxxxxxxxxxxxxxxxxx
# GITLAB_PROJECT_ID=namespace/project   # or numeric id
# GITLAB_BRANCH=main
# GITLAB_PATH_PREFIX=                   # optional subfolder
# GITLAB_PAGES_BASE=https://namespace.gitlab.io/project
# GITLAB_NAMESPACE=namespace            # used if GITLAB_PAGES_BASE is not set
# GITLAB_PROJECT_NAME=project           # used if GITLAB_PAGES_BASE is not set
# GITLAB_API_BASE=https://gitlab.com/api/v4   # for self-hosted GitLab

# ── Without any of the tokens above ──────────────────────────────────────────
# Drop falls back to the "local" provider: experiments are stored in the DB
# and served at /api/experiments/[slug]/preview — handy for demos/staging but
# the URL only resolves on this Drop instance's origin.
